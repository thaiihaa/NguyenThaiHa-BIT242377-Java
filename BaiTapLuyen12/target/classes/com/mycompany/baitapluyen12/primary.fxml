<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/8.0.171" 
      xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.mycompany.baitapluyen12.ChatController">
    
    <padding>
        <Insets bottom="10" left="10" right="10" top="10" />
    </padding>

    <TextArea fx:id="chatArea" VBox.vgrow="ALWAYS" editable="false" wrapText="true" />

    <HBox spacing="10">
        <TextField fx:id="messageInput" HBox.hgrow="ALWAYS" promptText="Nhập tin nhắn..." onAction="#handleSend"/>
        <Button text="Gửi" onAction="#handleSend" minWidth="60"/>
    </HBox>
    
</VBox>